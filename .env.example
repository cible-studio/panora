# ── WhatsApp (notifications techniciens — module Pose OOH) ──────────────
# Provider verrouillé en prod : "twilio". CallMeBot reste dispo pour debug
# local mais ne doit JAMAIS être utilisé en prod (1 apikey = 1 destinataire).
WHATSAPP_PROVIDER=twilio
WHATSAPP_ENABLED=true

# Twilio — sandbox pour démarrer (aucune approval nécessaire), puis WhatsApp
# Business approuvé Meta pour la prod réelle.
# Console : https://console.twilio.com → Messaging → Try it out → Send a WhatsApp message
TWILIO_SID=
TWILIO_AUTH_TOKEN=
# Sandbox commun Twilio : +14155238886 — chaque destinataire doit d'abord
# envoyer "join <code-sandbox>" en WhatsApp à ce numéro.
# En prod : remplacer par ton numéro WhatsApp Business approuvé.
TWILIO_WHATSAPP_FROM=+14155238886

# Content Template approuvé (PROD UNIQUEMENT, après soumission Meta).
# Format : HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx (33 chars).
# Tant que vide → mode free-form (sandbox / 24h-window). Voir runbook.
TWILIO_CONTENT_SID_POSE_ASSIGNMENT=

# CallMeBot — DEV/TEST UNIQUEMENT, à ne jamais activer en prod
CALLMEBOT_API_KEY=
